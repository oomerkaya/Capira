<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device through Google backup or a
     device-to-device transfer. The portfolio stays local (moved with the
     app's own backup file), and the secure-storage key would not survive a
     restore anyway (its Keystore key stays on the old device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
